# TAKEOVER environment template — safe to commit (no real secrets here).
# Copy to `.env` for local development: `copy .env.example .env` (Windows) or `cp .env.example .env`.
# `.env` is gitignored. All values below are server-side only and must never be
# exposed to the browser bundle.

# PostgreSQL connection string (Supabase in production). Not required for
# Phase 1: the API boots and GET /health works without a live database.
DATABASE_URL=

# Secret used for server-side session signing/derivation (Phase 3+).
SESSION_SECRET=

# Nimiq blockchain read/RPC endpoint for server-side payment verification (Phase 8).
# When unset, the server defaults to the public https://rpc.nimiqwatch.com
# (rate-limited, no uptime guarantee). Override with a self-hosted node URL
# for production hardening. Fallback procedure is documented in AI_HANDOFF.md.
NIMIQ_RPC_URL=

# Nimiq network identifier (e.g. mainnet, testnet) for verification policy (Phase 8).
NIMIQ_NETWORK=

# Comma-separated allowlist of admin wallet addresses (server-controlled roles).
ADMIN_WALLET_ADDRESSES=

# Comma-separated CORS allowlist for the Vercel frontend origin(s).
# Dev default when unset: http://localhost:5173. Production: from env only.
# Example: CORS_ORIGINS=https://takeover.vercel.app
CORS_ORIGINS=

# Claim hold window in seconds (default 600 = 10 minutes). Holds expire
# lazily on read; expired holds restore inventory exactly once.
CLAIM_HOLD_TTL_SECONDS=

# Payment_pending window in seconds (default 1800 = 30 minutes, FR-05). A
# still-pending verification older than this ages the claim to payment_review
# instead of pending. Inventory is NOT restored on this transition.
PAYMENT_REVIEW_TIMEOUT_SECONDS=

# Deposit-verification window in seconds (default 1800 = 30 minutes, FR-12).
# Applies from deposit_submitted entry; on expiry without a verified deposit
# the claim ages to payment_review with inventory still reserved, for admin
# resolution via the existing review surface.
ESCROW_DEPOSIT_VERIFICATION_SECONDS=

# Delivery window in seconds (default 86400 = 24 hours, Phase 14d-2).
# Funded → delivery deadline: delivery_deadline = funded_at + this window.
# Enforcement (release/refund on timeout) is a later phase.
ESCROW_DELIVERY_WINDOW_SECONDS=

# Polygon JSON-RPC endpoint for server-side USDT escrow event verification
# (14d-2+). Fail-closed when unset: escrow state never advances optimistically.
POLYGON_RPC_URL=

# Polygon escrow contract address (USDT escrow; 14d-2+). Read by the backend
# and the contract repo; never hardcoded.
USDT_ESCROW_CONTRACT_ADDRESS=

# Canonical USDT ERC-20 contract address on Polygon (6 decimals; 14d-2+).
USDT_TOKEN_ADDRESS=

# Server signer address that calls the escrow contract release/refund (14d-2+).
ESCROW_SIGNER_ADDRESS=

# Server-controlled NIM escrow wallet address (custodial hold duration only).
NIM_ESCROW_WALLET_ADDRESS=

# Optional error-monitoring DSN (only if approved during implementation).
SENTRY_DSN=
